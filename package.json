{
  "name": "trust-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "Google Apps Script and Google Sheets MVP for internal trust operations management.",
  "scripts": {
    "check": "node scripts/static-check.js && node scripts/verify-time-guards.js",
    "clasp:configure": "node scripts/configure-clasp.js",
    "clasp:login": "npx @google/clasp login",
    "clasp:push": "node scripts/configure-clasp.js && npx @google/clasp push",
    "clasp:pull": "node scripts/configure-clasp.js && npx @google/clasp pull",
    "clasp:deploy": "node scripts/configure-clasp.js && npx @google/clasp deploy"
  },
  "engines": {
    "node": ">=18"
  }
}
